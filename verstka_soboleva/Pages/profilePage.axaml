<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="verstka_soboleva.profilePage">

 <Grid RowDefinitions="Auto,*" Margin="5"> 
    <TextBlock Grid.Row="0" Text="Профиль" FontWeight="Bold" FontSize="20" Margin="0,10"/>
        <Border Classes="card" Grid.Row="1" Width="500" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top"> 
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="25" RowSpacing="15">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Имя" FontWeight="Bold"/> 
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CurrentUser.Name}"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Группа" FontWeight="Bold"/> 
                <Border Grid.Column="1" Grid.Row="1" Background="#409500FF" Padding="5,2" CornerRadius="3" HorizontalAlignment="Left"> 
                    <TextBlock Text="{Binding CurrentUser.Group}" Foreground="#7256BA"/> 
                </Border> 
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Роль" FontWeight="Bold"/> 
                <Border Grid.Column="1" Grid.Row="2" Background="#400015FF" Padding="5,2" CornerRadius="3" HorizontalAlignment="Left"> 
                    <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#5E80E6"/> 
                </Border> 
                <TextBlock Grid.Column="0" Grid.Row="3" Text="Описание" FontWeight="Bold" VerticalAlignment="Top"/> 
                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding CurrentUser.Description}" TextWrapping="Wrap" MaxWidth="350"/> 
            </Grid>
        </Border> 
 </Grid> 
</UserControl>