<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="verstka_soboleva.reviewPage">

        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="5">
            
        <TextBlock Grid.Row="0" Text="Обзор" FontWeight="Bold" FontSize="20" Margin="0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="0,10">
            <Border  Classes="card" Height="120" Width="180" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="Проекты" FontSize="14"/>
                    <TextBlock Text="12" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Активных проектов" FontSize="12"/>
                </StackPanel>
            </Border>
           <Border  Classes="card" Height="120" Width="180" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="Задачи" FontSize="14"/>
                    <TextBlock Text="48" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="В работе" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border  Classes="card" Height="120" Width="180" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="Команда" FontSize="14"/>
                    <TextBlock Text="8" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Участников" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border  Classes="card" Height="120" Width="180" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="Сроки" FontSize="14"/>
                    <TextBlock Text="5" FontSize="30" FontWeight="Bold" Foreground="Red"/>
                    <TextBlock Text="Просрочено" FontSize="12" Foreground="Red"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, *" Margin="0,10" ColumnSpacing="20">
        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="20">
             <Border  Classes="card" Height="250" Width="520"  CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Активные проекты" FontWeight="Bold" Margin="0,10"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Avalonia UI Redesign" Margin="0,5"/>
                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" Margin="0,5">
                    <Border Background="#409500FF" Padding="2" Width="65" Height="20" CornerRadius="3" HorizontalAlignment="Left">
                        <TextBlock Text="Дизайн" Foreground="#7256BA" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="65%" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="65" Height="5" Width="230" Foreground="#4B1BC4"/>

                </StackPanel>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Мобильное приложение" Margin="0,5"/>
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Vertical" Margin="0,5">
                    <Border Background="#400015FF" Padding="2" Width="90" Height="20" CornerRadius="3" HorizontalAlignment="Left">
                        <TextBlock Text="Разработка" Foreground="#5E80E6" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="40%" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="40" Height="5" Width="230" Foreground="#5E80E6"/>
                </StackPanel>
                <TextBlock Grid.Column="0" Grid.Row="3" Text="Корпоративный сайт" Margin="0,5"/>
                 <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Vertical" Margin="0,5">
                    <Border Background="#400015FF" Padding="2" Width="90" Height="20" CornerRadius="3" HorizontalAlignment="Left">
                        <TextBlock Text="Разработка" Foreground="#5E80E6" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="80%" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="80" Height="5" Width="230" Foreground="#73B04F"/>
                </StackPanel>
                </Grid>
            </Border>

            <Border  Classes="card" Height="180" Width="520" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20">
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Последние задачи" FontWeight="Bold" Margin="0,10"/>
                        <CheckBox  Grid.Column="0" Grid.Row="1" Content="Разработать макет главной страницы"/>
                        <CheckBox  Grid.Column="0" Grid.Row="2" Content="Реализовать авторизацию"/>
                        <CheckBox  Grid.Column="0" Grid.Row="3" Content="Подготовить презентацию"/>
                    <Border Grid.Column="1" Grid.Row="1" Background="#409500FF" Padding="2" Width="65" Height="20" CornerRadius="3" HorizontalAlignment="Left">
                        <TextBlock Text="Дизайн" Foreground="#7256BA" HorizontalAlignment="Center"/>
                    </Border>
                     <Border Grid.Column="1" Grid.Row="2" Background="#400015FF" Padding="2" Width="90" Height="20" CornerRadius="3" HorizontalAlignment="Left">
                        <TextBlock Text="Разработка" Foreground="#5E80E6" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="3" Background="#4022FF00" Padding="2" Width="90" Height="20" CornerRadius="3" HorizontalAlignment="Left">
                        <TextBlock Text="Маркетинг" Foreground="#73B04F" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="15.05.2024" Margin="0,10"/>
                    <TextBlock Grid.Column="2" Grid.Row="2" Text="14.05.2024" Margin="0,10"/>
                    <TextBlock Grid.Column="2" Grid.Row="3" Text="13.05.2024" Margin="0,10"/>
                </Grid>
            </Border>
        </StackPanel>
        <Border Classes="card" VerticalAlignment="Top" Grid.Column="1" Height="300" Width="350" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20">
       <StackPanel Orientation="Vertical">
        <TextBlock Grid.Column="0" Grid.Row="0" Text="Календарь" FontWeight="Bold" Margin="0,10"/>
       <Calendar  CornerRadius="10" Height="200" Width="330" HorizontalAlignment="Center"/>
       </StackPanel>
        </Border>

        </Grid>

        </Grid>
</UserControl>
