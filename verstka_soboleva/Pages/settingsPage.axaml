<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="verstka_soboleva.settingsPage">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="5">
            
        <TextBlock Grid.Row="0" Text="Настройки" FontWeight="Bold" FontSize="20" Margin="0,10"/>
           <Border  Classes="card" Grid.Row="1" Width="500" CornerRadius="10" BoxShadow="0 0 5 0 #40000000" Padding="20" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Темная тема" FontWeight="SemiBold" FontSize="15"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" x:Name="ThemeToggle" VerticalAlignment="Center" Margin="20,0,0,0" OffContent="" OnContent="" Click="ThemeToggle_Click"/>
            </Grid>
        </Border>
        </Grid>
</UserControl>
